{
  "manifest_version": 3,
  "name": "SE_Avtomat",
  "version": "1.0",
  "description": "Расширение для автоматизации процессов на сайте SurfEarner",
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Нажми, что бы открыть"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://surfearner.com/*",
    "https://www.youtube.com/*"
  ]
}
